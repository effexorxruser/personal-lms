# Phase 2: секреты не хранятся в репозитории. Значения в этом файле примерные.
# Дубликаты переменных: поддерживаются алиасы БЕЗ префикса PERSONAL_LMS_ для ключей ниже —
# см. docs/deployment/ENVIRONMENT_CONFIGURATION.md (APP_MODE, SESSION_*, ENABLE_*, SESSION_SECRET_KEY и т.д.).

# Название приложения для FastAPI metadata и базового UI.
# Секрет: нет. Обязательно менять: нет.
PERSONAL_LMS_APP_NAME=personal-lms

# Включает debug mode в приложении.
# Секрет: нет. Обязательно менять: для production оставить false.
PERSONAL_LMS_DEBUG=false

# Режим развёртывания: friend_only (по умолчанию) | public.
# Алиас: APP_MODE=friend_only
PERSONAL_LMS_APP_MODE=friend_only

# Опционально: базовый URL инстанса (документы и будущие абсолютные ссылки).
# Алиас: APP_BASE_URL=
PERSONAL_LMS_APP_BASE_URL=

# URL подключения к SQLite базе данных.
# Секрет: нет для локального SQLite. Обязательно менять: при смене пути к файлу базы.
PERSONAL_LMS_DATABASE_URL=sqlite:///./instance/personal_lms.db

# Ключ подписи cookie-сессии (SessionMiddleware).
# Секрет: да. Обязательно менять: да, перед любым shared/prod запуском (не короче 32 символов).
PERSONAL_LMS_SESSION_SECRET_KEY=change-me-before-production

# Алиас: SESSION_SECRET_KEY=

# HTTPS-only для cookie сессии (ставить true за reverse proxy с TLS).
# Алиас: SESSION_COOKIE_SECURE=false
PERSONAL_LMS_SESSION_COOKIE_SECURE=false

# SameSite для cookie сессии: lax | strict | none.
# Алиас: SESSION_COOKIE_SAMESITE=lax
PERSONAL_LMS_SESSION_COOKIE_SAMESITE=lax

# Имя cookie сессии.
# Алиас: SESSION_COOKIE_NAME=session
PERSONAL_LMS_SESSION_COOKIE_NAME=session

# TTL cookie в секундах; пусто — без ограничения возраста.
# Алиас: SESSION_MAX_AGE=
PERSONAL_LMS_SESSION_MAX_AGE=

# Терминал уроков (доверенный VPS). По умолчанию выключен.
# Алиас: ENABLE_TERMINAL=false
PERSONAL_LMS_ENABLE_TERMINAL=false

# Поверхность Lain AI Helper (online при наличии ключа OpenAI).
# Алиас: ENABLE_AI_HELPER=true или PERSONAL_LMS_AI_HELPER_ENABLED=true / AI_HELPER_ENABLED=
PERSONAL_LMS_ENABLE_AI_HELPER=true

# Предупреждение при старте о политике «публичного» режима (не меняет friend-only код).
# Алиас: ENABLE_PUBLIC_MODE=false
PERSONAL_LMS_ENABLE_PUBLIC_MODE=false

# Зарезервировано — предупреждение в логе при включении.
# Алиас: ENABLE_EXPERIMENTAL_IMPORTS=false
PERSONAL_LMS_ENABLE_EXPERIMENTAL_IMPORTS=false

# API ключ OpenAI для online-режима helper.
# Секрет: да. Обязательно менять: да, если нужен online-режим.
PERSONAL_LMS_OPENAI_API_KEY=

# Модель для Lain helper.
# Секрет: нет. Обязательно менять: нет.
PERSONAL_LMS_AI_HELPER_MODEL=gpt-4o-mini

# Таймаут ответа helper в секундах.
# Секрет: нет. Обязательно менять: нет.
PERSONAL_LMS_AI_HELPER_TIMEOUT_SECONDS=12

# --- Next.js / Better-Auth (target stack, Phase 1+) ---

# PostgreSQL connection string for Prisma.
DATABASE_URL=postgresql://personal_lms:personal_lms@localhost:5432/personal_lms

# Better-Auth secret (min 32 chars). Секрет: да.
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Public app URL for auth callbacks (server). Открывайте UI с того же host (localhost или 127.0.0.1).
BETTER_AUTH_URL=http://localhost:3000
# Опционально для SSR; в браузере клиент использует window.location.origin.
# NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Dev seed admin (только development).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-dev-password
